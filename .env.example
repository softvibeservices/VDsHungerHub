DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="your_jwt_secret_here"
NEXT_PUBLIC_APP_NAME="VD's Hunger Hub"

# MSG91 OTP Widget credentials (no-DLT path)
# Get Widget ID from MSG91 dashboard: OTP → Widgets
MSG91_BASE_URL="https://control.msg91.com"
MSG91_AUTH_KEY="your_msg91_auth_key_here"
MSG91_WIDGET_ID="your_msg91_widget_id_here"
# Public widget ID & Auth key — required by MSG91 Widget JS SDK for tokenAuth authentication
NEXT_PUBLIC_MSG91_WIDGET_ID="your_msg91_widget_id_here"
NEXT_PUBLIC_MSG91_AUTH_KEY="your_msg91_auth_key_here"

# Server-side pepper for hashing the client fingerprint.
# Generate with: openssl rand -hex 32
# CRITICAL: This MUST be set in production. The default "default_salt" fallback
# in customer-auth.ts is functionally equivalent to no salt — set this value.
# Rotate ONLY if you intentionally want to invalidate every existing DeviceFingerprint
# row (rotating logs every device out of "trusted" status simultaneously).
DEVICE_FINGERPRINT_SERVER_SALT="generate_a_long_random_string_here"
